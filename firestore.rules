rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidVault(data) {
      return data.keys().hasOnly(['teamIds', 'onboarded'])
        && data.teamIds is list
        && data.teamIds.size() <= 200
        && data.onboarded is bool;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /vault/{vaultId} {
        allow read: if isSignedInAs(userId) && vaultId == 'favorites';
        allow create, update: if isSignedInAs(userId)
          && vaultId == 'favorites'
          && isValidVault(request.resource.data);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
